# Deployment-only credentials; never save keys in task JSON or commit this file with values.
CONTENT_TEXT_API_KEY=
CONTENT_IMAGE_API_KEY=
# CPA runs only on the server loopback interface. This key belongs to CPA, not OpenAI.
CONTENT_CPA_API_KEY=
CONTENT_CPA_BASE_URL=http://127.0.0.1:8317/v1
# Optional: isolated ChatGPT login for Codex native images (no API key required).
# Use this directory only for the image process; preserve the text account.
CONTENT_IMAGE_CODEX_HOME=/root/.codex-content-images
# Keep generated PNG files across worker restarts / releases.
CONTENT_ASSET_DIR=/home/lushg/content-assets
# API base URL (including /v1), model names, prompts and schedules are configured in the admin UI.

# Optional: absolute path to the Codex executable; uses the worker account login.
# CONTENT_CODEX_BIN=/usr/local/bin/codex
# Optional: use the server's existing Codex provider endpoint, without personal tool configuration.
# CONTENT_CODEX_BASE_URL=https://your-approved-provider.example/v1
