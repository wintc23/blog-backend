# Load the website/database/model environment before these settings.
# Keep your environment file outside the repository, with mode 0600.
# Never derive Owner from active CLI login.
LARK_BRIDGE_APP_ID=cli_your_app
LARK_BRIDGE_OWNER_OPEN_ID=ou_your_owner
LARK_BRIDGE_ADMIN_USER_ID=1
LARK_BRIDGE_STATE_DIR=var/lark-bridge
LARK_BRIDGE_CLI=lark-cli
CONTENT_CODEX_BIN=codex
# Optional: blank returns relative links; can include a deployment path prefix.
LARK_BRIDGE_SITE_URL=
LARK_BRIDGE_IMAGE_MODEL=gpt-image-2.5-flare
